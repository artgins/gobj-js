{
  "name": "@yuneta/gobj-js",
  "version": "7.30.0",
  "description": "GObject + FSM runtime for JavaScript — event-driven components with typed attributes, pub/sub, and WebSocket inter-event client",
  "author": "ArtGins",
  "license": "MIT",
  "type": "module",
  "main": "dist/gobj-js.cjs.js",
  "module": "dist/gobj-js.es.js",
  "exports": {
    "import": "./dist/gobj-js.es.js",
    "require": "./dist/gobj-js.cjs.js"
  },
  "files": [
    "dist/",
    "THIRD-PARTY-NOTICES"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
