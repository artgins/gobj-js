{
    "__description__": "What a value given as json becomes for each attribute type: the same in C (command_parameter_from_json(), json2item(); yunetas tests/c/attr_types) and in JS (gobj-js tests/attr_types.test.js). 'expect' is the value written; 'refused' why it is refused, null when there is no value. A real is written with its decimal point, so that C reads it as a real.",
    "cases": [
        {"type": "integer", "value": "42",                      "expect": 42},
        {"type": "integer", "value": "-5",                      "expect": -5},
        {"type": "integer", "value": "-0",                      "expect": 0},
        {"type": "integer", "value": "007",                     "refused": "a text that does not read as one"},
        {"type": "integer", "value": "+5",                      "refused": "a text that does not read as one"},
        {"type": "integer", "value": " 5",                      "refused": "a text that does not read as one"},
        {"type": "integer", "value": "12abc",                   "refused": "a text that does not read as one"},
        {"type": "integer", "value": "1e3",                     "refused": "a text that does not read as one"},
        {"type": "integer", "value": "0x10",                    "refused": "a text that does not read as one"},
        {"type": "integer", "value": "99999999999999999999",    "refused": "a number out of its range"},
        {"type": "integer", "value": "5\u0000x",                "refused": "a text with a NUL in it"},
        {"type": "integer", "value": "",                        "refused": null},
        {"type": "integer", "value": null,                      "refused": null},
        {"type": "integer", "value": 7,                         "expect": 7},
        {"type": "integer", "value": 2.0,                       "expect": 2},
        {"type": "integer", "value": 2.7,                       "refused": "a real with decimals"},
        {"type": "integer", "value": 1e19,                      "refused": "a number out of its range"},
        {"type": "integer", "value": true,                      "expect": 1},
        {"type": "integer", "value": false,                     "expect": 0},
        {"type": "integer", "value": {},                        "refused": "an object"},
        {"type": "integer", "value": [1],                       "refused": "an array"},

        {"type": "real",    "value": "2.5",                     "expect": 2.5},
        {"type": "real",    "value": "1E3",                     "expect": 1000.0},
        {"type": "real",    "value": "-1.5e-3",                 "expect": -0.0015},
        {"type": "real",    "value": "7",                       "expect": 7.0},
        {"type": "real",    "value": ".5",                      "refused": "a text that does not read as one"},
        {"type": "real",    "value": "5.",                      "refused": "a text that does not read as one"},
        {"type": "real",    "value": "nan",                     "refused": "a text that does not read as one"},
        {"type": "real",    "value": "inf",                     "refused": "a text that does not read as one"},
        {"type": "real",    "value": "1e999",                   "refused": "a number out of its range"},
        {"type": "real",    "value": "",                        "refused": null},
        {"type": "real",    "value": 3,                         "expect": 3.0},
        {"type": "real",    "value": 0.25,                      "expect": 0.25},
        {"type": "real",    "value": true,                      "expect": 1.0},
        {"type": "real",    "value": "x",                       "refused": "a text that does not read as one"},
        {"type": "real",    "value": [],                        "refused": "an array"},

        {"type": "boolean", "value": "yes",                     "expect": true},
        {"type": "boolean", "value": "on",                      "expect": true},
        {"type": "boolean", "value": "TRUE",                    "expect": true},
        {"type": "boolean", "value": "off",                     "expect": false},
        {"type": "boolean", "value": "No",                      "expect": false},
        {"type": "boolean", "value": "1",                       "expect": true},
        {"type": "boolean", "value": "0",                       "expect": false},
        {"type": "boolean", "value": "2",                       "expect": true},
        {"type": "boolean", "value": "maybe",                   "refused": "a text that does not read as one"},
        {"type": "boolean", "value": "1.5",                     "refused": "a text that does not read as one"},
        {"type": "boolean", "value": "",                        "refused": null},
        {"type": "boolean", "value": null,                      "refused": null},
        {"type": "boolean", "value": 0,                         "expect": false},
        {"type": "boolean", "value": 2,                         "expect": true},
        {"type": "boolean", "value": 0.5,                       "expect": true},
        {"type": "boolean", "value": false,                     "expect": false},
        {"type": "boolean", "value": {},                        "refused": "an object"},

        {"type": "list",    "value": "[1, 2]",                  "expect": [1, 2]},
        {"type": "list",    "value": "[]",                      "expect": []},
        {"type": "list",    "value": "{\"a\": 1}",              "refused": "a text that does not read as one"},
        {"type": "list",    "value": "[1, 2",                   "refused": "a text that does not read as one"},
        {"type": "list",    "value": "",                        "refused": "a text that does not read as one"},
        {"type": "list",    "value": [1],                       "expect": [1]},
        {"type": "list",    "value": {"a": 1},                  "refused": "an object"},
        {"type": "list",    "value": 5,                         "refused": "an integer"},
        {"type": "list",    "value": null,                      "refused": null},

        {"type": "dict",    "value": "{\"a\": 1}",              "expect": {"a": 1}},
        {"type": "dict",    "value": "[1]",                     "refused": "a text that does not read as one"},
        {"type": "dict",    "value": "{\"a\": ",                "refused": "a text that does not read as one"},
        {"type": "dict",    "value": {"b": 2},                  "expect": {"b": 2}},
        {"type": "dict",    "value": 5,                         "refused": "an integer"},
        {"type": "dict",    "value": 2.5,                       "refused": "a real"},
        {"type": "dict",    "value": true,                      "refused": "a boolean"},
        {"type": "dict",    "value": [],                        "refused": "an array"},
        {"type": "dict",    "value": null,                      "refused": null}
    ]
}
